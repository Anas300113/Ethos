# Copy to .env and fill in before running Prisma or the app.
# Local Postgres example:
#   DATABASE_URL="postgresql://ethos:ethos@localhost:5432/ethos?schema=public"
DATABASE_URL="postgresql://ethos:ethos@localhost:5432/ethos?schema=public"

# Signs the anonymous mobile reader token (v1.<readerId>.<expiresAt>.<hmac>).
# Required in production; any development fallback refuses to start there.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
READER_TOKEN_SECRET=""

# Canonical public origin used for shared story links (deep link + web URL).
# Falls back to the request origin on preview deployments when unset.
PUBLIC_APP_URL=""

