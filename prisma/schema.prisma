// ETHOS — Prisma schema (PostgreSQL + pgvector-ready).
// Domain enums mirror src/types/story.ts so the DB stays a 1:1
// persistence layer for the dossier model.
// pgvector columns use Unsupported("vector(1536)"); a SQL migration
// enables the extension and declares the real vector columns.
// Quote text is stored verbatim; the <=250-char fair-use cap is
// enforced in the application/verification layer, not the DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceTier {
  PRIMARY
  SECONDARY_TIER1
  SECONDARY_TIER2
  FACT_CHECKER
}

enum ClaimStatus {
  SUPPORTED
  CORROBORATED
  PARTIALLY_SUPPORTED
  DISPUTED
  UNVERIFIED
  CONTRADICTED
  OUTDATED
}

enum StoryTopic {
  UK
  World
  Technology
  Science
  Business
  Climate
  Sport
  Culture
  Health
  Education
}

enum EvidenceDocumentType {
  STATISTICAL_RELEASE
  GOVERNMENT_DOCUMENT
  COURT_FILING
  OFFICIAL_STATEMENT
  PARLIAMENTARY_RECORD
  ACADEMIC_PAPER
}

enum SourceStance {
  CONFIRMS
  ADDS_CONTEXT
  DISPUTES
  OMITS
}

model Publisher {
  id      String     @id @default(cuid())
  name    String
  domain  String     @unique
  tier    SourceTier
  country String?

  articles ArticleSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Story {
  id                 String     @id @default(cuid())
  slug               String     @unique
  headline           String
  oneSentenceSummary String
  heroImageUrl       String?
  heroImageCaption   String?
  topic              StoryTopic
  readingTimeMinutes Int
  lastUpdated        DateTime
  version            Int        @default(1)
  isDeveloping       Boolean    @default(false)
  whatHappened       String     @db.Text
  whyItMatters       String     @db.Text
  whatWeKnow         String[]
  whatIsUnclear      String[]
  sourcesAgreeOn     String[]

  embedding Unsupported("vector(1536)")?

  claims          Claim[]
  timeline        TimelineEvent[]
  primaryEvidence PrimaryEvidence[]
  sources         ArticleSource[]
  stanceItems     SourceComparisonItem[]
  updates         StoryUpdate[]
  relatedStories  Story[]                @relation("RelatedStories")
  relatedTo       Story[]                @relation("RelatedStories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topic])
}

model Claim {
  id              String      @id @default(cuid())
  statement       String      @db.Text
  status          ClaimStatus
  confidenceScore Float
  explanation     String      @db.Text
  lastVerified    DateTime
  storyId         String
  story           Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)

  embedding Unsupported("vector(1536)")?

  primaryEvidence PrimaryEvidence[]
  corroborating   SourceQuote[]     @relation("CorroboratingQuotes")
  disputing       DisputeQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyId])
  @@index([status])
}

model PrimaryEvidence {
  id           String               @id @default(cuid())
  title        String
  url          String?
  documentType EvidenceDocumentType
  issuingBody  String
  summary      String               @db.Text
  date         String?
  excerpt      String?              @db.Text
  storyId      String
  story        Story                @relation(fields: [storyId], references: [id], onDelete: Cascade)
  claims       Claim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyId])
  @@index([issuingBody])
}

model ArticleSource {
  id          String    @id @default(cuid())
  url         String    @unique
  title       String
  author      String?
  publishedAt DateTime
  retrievedAt DateTime
  snippet     String?   @db.Text
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id])
  storyId     String
  story       Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyId])
  @@index([publisherId])
}

model SourceQuote {
  id            String @id @default(cuid())
  publisherName String
  url           String
  quote         String @db.Text
  claimId       String
  claim         Claim  @relation("CorroboratingQuotes", fields: [claimId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([claimId])
}

model DisputeQuote {
  id            String @id @default(cuid())
  publisherName String
  url           String
  quote         String @db.Text
  disputeReason String @db.Text
  claimId       String
  claim         Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([claimId])
}

model SourceComparisonItem {
  id      String @id @default(cuid())
  topic   String
  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  points SourceComparisonPoint[]

  createdAt DateTime @default(now())

  @@index([storyId])
}

model SourceComparisonPoint {
  id         String               @id @default(cuid())
  sourceName String
  reporting  String               @db.Text
  stance     SourceStance         @default(CONFIRMS)
  itemId     String
  item       SourceComparisonItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  timestamp   DateTime
  displayTime String
  eventText   String   @db.Text
  sourceUrl   String?
  sourceName  String?
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([storyId])
  @@index([timestamp])
}

model StoryUpdate {
  id          String   @id @default(cuid())
  timestamp   DateTime
  whatChanged String   @db.Text
  reason      String?  @db.Text
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([storyId])
}
