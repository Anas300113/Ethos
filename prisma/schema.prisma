// ETHOS — Prisma schema (PostgreSQL + pgvector-ready).
// Domain enums mirror src/types/story.ts so the DB stays a 1:1
// persistence layer for the dossier model.
// pgvector columns use Unsupported("vector(1536)"); a SQL migration
// enables the extension and declares the real vector columns.
// Quote text is stored verbatim; the <=250-char fair-use cap is
// enforced in the application/verification layer, not the DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceTier {
  PRIMARY
  SECONDARY_TIER1
  SECONDARY_TIER2
  FACT_CHECKER
}

enum ClaimStatus {
  SUPPORTED
  CORROBORATED
  PARTIALLY_SUPPORTED
  DISPUTED
  UNVERIFIED
  CONTRADICTED
  OUTDATED
}

enum StoryTopic {
  UK
  World
  Technology
  Science
  Business
  Climate
  Sport
  Culture
  Health
  Education
}

enum EvidenceDocumentType {
  STATISTICAL_RELEASE
  GOVERNMENT_DOCUMENT
  COURT_FILING
  OFFICIAL_STATEMENT
  PARLIAMENTARY_RECORD
  ACADEMIC_PAPER
}

enum SourceStance {
  CONFIRMS
  ADDS_CONTEXT
  DISPUTES
  OMITS
}

/// Curated-story lifecycle. INGESTED material lives in IngestedItem and never
/// carries this status; only rows the curation pipeline promotes get one.
/// PUBLISHED / UPDATED / REVALIDATED are reader-visible; everything else is
/// pipeline-internal or terminal. Terminal states keep their rows for audit.
enum StoryStatus {
  CANDIDATE
  CLUSTERED
  ANALYSING
  EVIDENCE_REVIEW
  DRAFT
  VALIDATING
  PUBLISHED
  UPDATED
  REVALIDATED
  REJECTED
  ARCHIVED
}

model Publisher {
  id      String     @id @default(cuid())
  name    String
  domain  String     @unique
  tier    SourceTier
  country String?

  articles    ArticleSource[]
  /// Back-relation for the ingestion registry only. It declares nothing about
  /// editorial standing: a publisher's `tier` is curated data that ingestion
  /// reads but never writes (new publishers are always SECONDARY_TIER2).
  ingestFeeds IngestFeed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Device-scoped reader identity for MVP. No password, no e-mail: the app
/// sets an HttpOnly `ethos_reader` cookie holding one of these stable ids,
/// and bookmarks / preferences / reading history hang off it. Deleting the
/// cookie starts a fresh anonymous profile; nothing personally identifying
/// is ever stored.
model ReaderProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  bookmarks      StoryBookmark[]
  preferences    ReaderPreference[]
  readingHistory ReadingEvent[]
}

/// One saved story for one reader. The saved copy records the story version
/// at save time, so the UI can say "Updated since you saved this" when the
/// curated story moves on without rewriting history.
model StoryBookmark {
  readerId     String
  reader       ReaderProfile @relation(fields: [readerId], references: [id], onDelete: Cascade)
  storyId      String
  story        Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  savedVersion Int
  createdAt    DateTime      @default(now())

  @@id([readerId, storyId])
  @@index([readerId, createdAt])
}

/// Topic follow toggles for the For You feed. Ranking-only input: preferences
/// reorder stories, they never alter factual content or hide contradictory
/// evidence.
model ReaderPreference {
  readerId  String
  reader    ReaderProfile @relation(fields: [readerId], references: [id], onDelete: Cascade)
  topic     StoryTopic
  followed  Boolean       @default(true)
  updatedAt DateTime      @updatedAt

  @@id([readerId, topic])
}

/// Lightweight read receipts. Used for "recently read" and for marking a
/// bookmark stale ("updated since you read this"). No article-level tracking.
model ReadingEvent {
  id       String        @id @default(cuid())
  readerId String
  reader   ReaderProfile @relation(fields: [readerId], references: [id], onDelete: Cascade)
  storyId  String
  story    Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  readAt   DateTime      @default(now())

  @@index([readerId, readAt])
  @@index([storyId, readAt])
}

model Story {
  id                 String      @id @default(cuid())
  slug               String      @unique
  headline           String
  oneSentenceSummary String
  heroImageUrl       String?
  heroImageCaption   String?
  topic              StoryTopic
  readingTimeMinutes Int
  lastUpdated        DateTime
  version            Int         @default(1)
  isDeveloping       Boolean     @default(false)
  /// Explicit lifecycle; only the *_PUBLISHED family (below) is reader-visible.
  status             StoryStatus @default(CANDIDATE)
  /// Which pipeline run/version of the curation code produced this row, so a
  /// future model or code change leaves history auditable, not overwritten.
  pipelineVersion    String      @default("mvp-1")
  aiProvider         String?
  aiModel            String?
  generatedAt        DateTime?
  whatHappened       String      @db.Text
  whyItMatters       String      @db.Text
  whatWeKnow         String[]
  whatIsUnclear      String[]
  sourcesAgreeOn     String[]

  embedding Unsupported("vector(1536)")?

  claims          Claim[]
  timeline        TimelineEvent[]
  primaryEvidence PrimaryEvidence[]
  sources         ArticleSource[]
  stanceItems     SourceComparisonItem[]
  updates         StoryUpdate[]
  bookmarks       StoryBookmark[]
  readingEvents   ReadingEvent[]
  relatedStories  Story[]                @relation("RelatedStories")
  relatedTo       Story[]                @relation("RelatedStories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topic])
}

model Claim {
  id                   String      @id @default(cuid())
  statement            String      @db.Text
  status               ClaimStatus
  confidenceScore      Float
  explanation          String      @db.Text
  lastVerified         DateTime
  storyId              String
  story                Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// Atomic-claim typing: what KIND of assertion this is. Opinions and
  /// predictions may be quoted and attributed, never established as fact.
  claimType            String      @default("STATEMENT")
  /// Who asserted it, when the reporting names one ("the minister said X").
  /// Null means the outlet itself asserts it. Stored, never inferred.
  claimant             String?
  /// Which pipeline/provider/version extracted it — provenance for "why did
  /// ETHOS publish this sentence?" survives model swaps.
  extractionProvenance String      @default("seed")
  aiProvider           String?
  aiModel              String?

  embedding Unsupported("vector(1536)")?

  primaryEvidence PrimaryEvidence[]
  corroborating   SourceQuote[]     @relation("CorroboratingQuotes")
  disputing       DisputeQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyId])
  @@index([status])
}

model PrimaryEvidence {
  id           String               @id @default(cuid())
  title        String
  url          String?
  documentType EvidenceDocumentType
  issuingBody  String
  summary      String               @db.Text
  date         String?
  excerpt      String?              @db.Text
  storyId      String
  story        Story                @relation(fields: [storyId], references: [id], onDelete: Cascade)
  claims       Claim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyId])
  @@index([issuingBody])
}

model ArticleSource {
  id          String           @id @default(cuid())
  url         String           @unique
  title       String
  author      String?
  publishedAt DateTime
  retrievedAt DateTime
  snippet     String?          @db.Text
  publisherId String
  publisher   Publisher        @relation(fields: [publisherId], references: [id])
  storyId     String
  story       Story            @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// Role inside the story: the reporting contribution, e.g. REPORTING,
  /// CORROBORATION, DISPUTE, PRIMARY_CONTEXT. Display-only, never a ranking.
  role        String           @default("REPORTING")
  /// Optional fast-path link back to the ingested candidate this source was
  /// promoted from. URL match stays the primary provenance signal.
  promotion   SourcePromotion?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyId])
  @@index([publisherId])
}

model SourceQuote {
  id            String @id @default(cuid())
  publisherName String
  url           String
  quote         String @db.Text
  claimId       String
  claim         Claim  @relation("CorroboratingQuotes", fields: [claimId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([claimId])
}

/// Promotion link: which ingested candidate an ArticleSource came from.
/// Optional and SetNull so deleting a staging row never deletes curated
/// history, and deleting curated rows never touches staging. The URL match
/// stays the primary provenance signal; this column is the fast path.
model SourcePromotion {
  id             String        @id @default(cuid())
  ingestedItemId String        @unique
  ingestedItem   IngestedItem  @relation(fields: [ingestedItemId], references: [id], onDelete: Cascade)
  articleId      String        @unique
  article        ArticleSource @relation(fields: [articleId], references: [id], onDelete: Cascade)
  promotedAt     DateTime      @default(now())
  promotedBy     String        @default("pipeline")
}

model DisputeQuote {
  id            String @id @default(cuid())
  publisherName String
  url           String
  quote         String @db.Text
  disputeReason String @db.Text
  claimId       String
  claim         Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([claimId])
}

model SourceComparisonItem {
  id      String @id @default(cuid())
  topic   String
  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  points SourceComparisonPoint[]

  createdAt DateTime @default(now())

  @@index([storyId])
}

model SourceComparisonPoint {
  id         String               @id @default(cuid())
  sourceName String
  reporting  String               @db.Text
  stance     SourceStance         @default(CONFIRMS)
  itemId     String
  item       SourceComparisonItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  timestamp   DateTime
  displayTime String
  eventText   String   @db.Text
  sourceUrl   String?
  sourceName  String?
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([storyId])
  @@index([timestamp])
}

model StoryUpdate {
  id          String   @id @default(cuid())
  timestamp   DateTime
  whatChanged String   @db.Text
  reason      String?  @db.Text
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([storyId])
}

// ---------------------------------------------------------------------------
// News ingestion pipeline (staging layer).
//
// Deliberately SEPARATE from the curated Story/Claim graph above. Ingested
// items are unvalidated candidates: writing them must never satisfy the
// publish gate, so nothing here cascades into Story/Claim/PrimaryEvidence,
// and no ingest code may touch those models (guarded by a test).
// Promotion from IngestedItem -> curated source stays an explicit editorial
// step. Only metadata + a fair-use excerpt are stored, never the full body.
// ---------------------------------------------------------------------------

enum FeedFormat {
  RSS_2_0
  ATOM_1_0
  RSS_1_0
}

/// Outcome of polling one feed. Named FeedRunStatus (not RunStatus) because
/// there is deliberately no run ledger — this labels a single feed outcome and
/// is stored on IngestFeed.lastStatus.
enum FeedRunStatus {
  OK
  NOT_MODIFIED
  REJECTED
  FAILED
}

/// Row state, not a run transition: a candidate is either usable or was refused
/// by normalisation. Per-run transitions (new / known / updated) are counted
/// on FeedRunOutcome and printed per feed; only the outcome label persists,
/// as IngestFeed.lastStatus.
enum IngestedStatus {
  STORED
  REJECTED
}

enum IngestedRejection {
  BAD_URL
  EMPTY_TITLE
  OFF_DOMAIN
  OFF_TOPIC
  STALE
  MISSING_DATE
  DUPLICATE_IN_FEED
}

enum DateProvenance {
  PUBLISHED
  MODIFIED
  FETCHED
}

model IngestFeed {
  id           String         @id @default(cuid())
  /// Feed URL — unique so a run is idempotent regardless of publisher renames.
  feedUrl      String         @unique
  publisherId  String
  publisher    Publisher      @relation(fields: [publisherId], references: [id])
  format       FeedFormat     @default(RSS_2_0)
  /// Editorial filter: an item is stored only if it matches this topic.
  topic        StoryTopic
  enabled      Boolean        @default(true)
  /// Conditional-GET validators from the last response (HTTP 304 support).
  etag         String?
  lastModified String?
  lastRunAt    DateTime?
  lastStatus   FeedRunStatus?
  lastError    String?

  items IngestedItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([publisherId])
}

model IngestedItem {
  id              String             @id @default(cuid())
  /// Normalised, tracking-parameter-free canonical URL — the dedupe key.
  url             String             @unique
  title           String
  author          String?
  excerpt         String?            @db.Text
  guid            String?
  feedId          String
  feed            IngestFeed         @relation(fields: [feedId], references: [id], onDelete: Cascade)
  topic           StoryTopic
  /// STORED = usable candidate; REJECTED = seen but refused, with the reason kept.
  status          IngestedStatus     @default(STORED)
  rejectionCode   IngestedRejection?
  rejectionReason String?
  /// How many runs this URL has appeared in (re-appearance is a cheap touch).
  seenCount       Int                @default(1)
  publishedAt     DateTime
  publishedSource DateProvenance     @default(PUBLISHED)
  /// Raw date string exactly as the feed supplied it, for provenance/auditing.
  publishedRaw    String?
  fetchedAt       DateTime
  /// sha256("title | excerpt") — detects retitled/re-summarised items.
  contentHash     String
  firstSeenAt     DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())

  promotion SourcePromotion?

  @@index([feedId])
  @@index([publishedAt])
  @@index([topic])
  @@index([status, publishedAt])
}
