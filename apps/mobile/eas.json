{
  "builds": {
    "cli": { "version": ">= 12.0.0" }
  },
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://10.0.2.2:3000/api/mobile/v1" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://ethos-news.vercel.app/api/mobile/v1" }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ethos-news.vercel.app/api/mobile/v1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": { "appName": "ETHOS" },
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
